<!DOCTYPE html>
<html lang="id"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Parasitologi Flashcard & Kuis</title>
<style>
:root{--bg:#fff7fb;--card:#fff;--tx:#2b2230;--mut:#7a6b80;--ac:#d6457f;--ac2:#fde3ef;--ok:#1f9d55;--bad:#d64545;--bd:#ecd5e0}
@media(prefers-color-scheme:dark){:root{--bg:#1c1720;--card:#2a232f;--tx:#f3ecf6;--mut:#a899ae;--ac:#ff7aa8;--ac2:#3a2a38;--ok:#4cd08a;--bad:#ff7a7a;--bd:#4a3d50}}
*{box-sizing:border-box}body{margin:0;font-family:system-ui,sans-serif;background:var(--bg);color:var(--tx)}
main{max-width:760px;margin:0 auto;padding:16px}h1{font-size:1.4rem;margin:6px 0}
.sub{color:var(--mut);font-size:.9rem;margin-bottom:12px}
.row{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
button{font:inherit;cursor:pointer;border:1px solid var(--bd);background:var(--card);color:var(--tx);border-radius:10px;padding:8px 12px}
button.on{background:var(--ac);color:#fff;border-color:var(--ac)}button.p{background:var(--ac);color:#fff;border-color:var(--ac)}
.chip{padding:5px 10px;font-size:.85rem;border-radius:99px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:12px;margin-top:10px}
.img{width:100%;max-height:360px;object-fit:contain;border-radius:10px;background:#00000010;display:block}
.fc{cursor:pointer;min-height:300px;text-align:center}.fc h2{margin:10px 0 4px;color:var(--ac)}
.fc ul{text-align:left;margin:6px auto;max-width:520px}.hint{color:var(--mut);font-size:.85rem}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.opts.one{grid-template-columns:1fr}
.opts button{padding:12px}.opts img{width:100%;height:130px;object-fit:contain;display:block}
.ok{background:var(--ok)!important;color:#fff!important}.bad{background:var(--bad)!important;color:#fff!important}
input[type=text]{width:100%;font:inherit;padding:10px;border-radius:10px;border:1px solid var(--bd);background:var(--card);color:var(--tx);margin-top:10px}
.bar{height:8px;background:var(--ac2);border-radius:9px;overflow:hidden;margin:8px 0}.bar i{display:block;height:100%;background:var(--ac)}
.fb{margin-top:10px;padding:10px;border-radius:10px;background:var(--ac2)}
.hide{display:none}
</style></head><body><main>
<h1>🪱 Parasitologi: Flashcard & Kuis</h1>
<div class="sub">Hafalkan nama parasit dari gambarnya. Pilih mode dan kelompok di bawah.</div>
<div class="row" id="modes"></div>
<div class="row" id="groups"></div>
<div class="row"><button id="rev" title="Hanya kartu yang salah/belum hafal">Ulangi yang salah (0)</button><button id="shuf" class="p">Acak ulang ↻</button></div>
<div class="bar"><i id="pb"></i></div><div class="hint" id="stat"></div>
<div id="stage"></div>
</main>
<script>
const DATA=[{"g": "Cestoda", "n": "Moniezia", "i": "img/p2_0.jpg", "t": ["Acetabula tidak bersenjata", "Organ reproduksi ganda", "Lebar proglotid > panjang", "Uterus di tepi"]}, {"g": "Cestoda", "n": "Diphyllobothrium", "i": "img/p2_1.jpg", "t": ["Bothria", "Uterus rosette di tengah", "Lebar proglotid > panjang"]}, {"g": "Cestoda", "n": "Fimbriaria", "i": "img/p2_2.jpg", "t": ["Skoleks berbentuk pseudokomplek (seperti terompet)"]}, {"g": "Cestoda", "n": "Spirometra", "i": "img/p3_3.jpg", "t": ["Lebar proglotid > panjang", "Uterus spiral (tampak seperti tanda =)", "Bothria"]}, {"g": "Cestoda", "n": "Dipylidium", "i": "img/p3_4.jpg", "t": ["Rostelum retraktil berkait", "Proglotid seperti biji mentimun / butir beras"]}, {"g": "Cestoda", "n": "Taenia", "i": "img/p3_5.jpg", "t": ["Skoleks globuler bersenjata (berkait)", "Percabangan uterus lateral"]}, {"g": "Cestoda", "n": "Raillietina", "i": "img/p4_6.jpg", "t": ["Rostelum dengan kait", "Sucker kecil tidak bersenjata", "Proglotid persegi panjang"]}, {"g": "Cestoda", "n": "Davainea", "i": "img/p4_7.jpg", "t": ["Rostelum bersenjata", "Acetabula bersenjata", "Lubang kelamin reguler", "Segmen melebar (mirip pion catur)"]}, {"g": "Trematoda", "n": "Echinostoma", "i": "img/p5_8.jpg", "t": ["Berbentuk langsing", "Oral sucker dikelilingi head collar", "Dipersenjatai 1-2 duri", "Ventral sucker lebih besar dari oral sucker"]}, {"g": "Trematoda", "n": "Eurythrema", "i": "img/p5_9.jpg", "t": ["Oral sucker > ventral sucker", "Selaput vitelin pendek", "Anterior lebih runcing dari Fasciola"]}, {"g": "Trematoda", "n": "Fasciola gigantica", "i": "img/p5_10.jpg", "t": ["Selaput vitelin memenuhi lateral tubuh", "Sisi kiri dan kanan hampir sejajar", "Penghisap ventral dan oral", "Anterior lebih tumpul dari Eurythrema"]}, {"g": "Trematoda", "n": "Paramphistomum", "i": "img/p6_11.jpg", "t": ["Ada ventral sucker dan oral sucker", "Bentuk conus", "Ventral sucker di posterior"]}, {"g": "Nematoda", "n": "Trichuris", "i": "img/p7_12.jpg", "t": ["Cacing cambuk", "Satu ujung tipis seperti benang, ujung lain tebal"]}, {"g": "Nematoda", "n": "Acuaria", "i": "img/p7_13.jpg", "t": ["Memiliki cordon", "Memiliki 2 pseudolabia lateral"]}, {"g": "Nematoda", "n": "Syngamus", "i": "img/p7_14.jpg", "t": ["Selalu berpasangan (jantan-betina menyatu, tampak 2 kepala)", "Ditemukan pada trakea ayam"]}, {"g": "Nematoda", "n": "Haemonchus", "i": "img/p8_15.jpg", "t": ["Kapsul bukal kecil", "Saluran reproduksi putih berpilin", "Saluran pencernaan merah"]}, {"g": "Nematoda", "n": "Ancylostoma", "i": "img/p8_16.jpg", "t": ["Ujung anterior melengkung ke dorsal", "Kapsul bukal punya 1-3 gigi", "Mulut melebar menganga", "Jantan: bursa kopulatriks"]}, {"g": "Nematoda", "n": "Tetrameres", "i": "img/p8_17.jpg", "t": ["Betina melebar seperti daun teratai"]}, {"g": "Nematoda", "n": "Heterakis", "i": "img/p9_18.jpg", "t": ["Ujung runcing", "Alae lateralis besar", "Spikula tidak sama", "Vulva di tengah tubuh betina"]}, {"g": "Nematoda", "n": "Oxyspirura", "i": "img/p9_19.jpg", "t": ["Ekor punya papila besar dan kecil", "Esofagus menyempit di tengah", "Ekor meruncing panjang", "Kepala tumpul"]}, {"g": "Nematoda", "n": "Trichinella", "i": "img/p9_20.jpg", "t": ["Dikenali dari larva/kista yang melingkar di dalam otot"]}, {"g": "Kutu", "n": "Goniocotes", "i": "img/p10_21.jpg", "t": ["Kutu penggigit", "Kepala lebih lebar, membulat", "Kepala lebih besar dari toraks"]}, {"g": "Kutu", "n": "Goniodes", "i": "img/p10_22.jpg", "t": ["Kutu penggigit", "Kepala bulat, cekung di belakang antena", "Antena 5 segmen", "Kepala lebih besar dari toraks"]}, {"g": "Kutu", "n": "Lipeurus", "i": "img/p10_23.jpg", "t": ["Kutu penggigit", "Kepala kecil, agak tumpul (mirip stormtrooper)", "Badan lebih bulat dari Columbicola"]}, {"g": "Kutu", "n": "Felicola", "i": "img/p10_24.jpg", "t": ["Kutu penggigit", "Ada celah di anterior kepala", "Kepala lancip", "Antena 3 segmen"]}, {"g": "Kutu", "n": "Haematopinus", "i": "img/p10_25.jpg", "t": ["Kutu penghisap (Anoplura)", "Antena 5 segmen", "Lempeng paratergal terlihat jelas", "Kepala memanjang, menyudut setelah antena", "Ada cakar"]}, {"g": "Kutu", "n": "Menacanthus", "i": "img/p10_26.jpg", "t": ["Kutu penggigit", "Berbulu lebat", "Kepala lebih besar dari toraks"]}, {"g": "Kutu", "n": "Menopon", "i": "img/p11_27.jpg", "t": ["Kutu penggigit", "Bulu tampak lebih lancip", "Lebih gepeng"]}, {"g": "Pinjal", "n": "Ctenocephalides", "i": "img/p12_28.jpg", "t": ["Dahi kurva", "Memiliki genal dan pronotal ctenidia", "Gepeng bilateral"]}, {"g": "Pinjal", "n": "Xenopsylla", "i": "img/p12_29.jpg", "t": ["Dahi kurva", "Tidak punya genal", "Tidak punya pronotal ctenidia", "Gepeng bilateral"]}, {"g": "Pinjal", "n": "Echinophaga", "i": "img/p12_30.jpg", "t": ["Dahi menyudut", "Tidak punya genal", "Tidak punya pronotal ctenidia", "Gepeng bilateral, bungkuk"]}, {"g": "Nyamuk & Lalat", "n": "Culex", "i": "img/p13_31.jpg", "t": ["Palpus pendek", "Antena biasa"]}, {"g": "Nyamuk & Lalat", "n": "Anopheles", "i": "img/p13_32.jpg", "t": ["Palpus panjang", "Antena berongga/berbulu lebat", "Vektor malaria"]}, {"g": "Nyamuk & Lalat", "n": "Haematobia", "i": "img/p14_33.jpg", "t": ["Probosis lancip untuk menusuk", "Vena sayap bagian bawah kabur", "Probosis dan palpus hampir sama panjang"]}, {"g": "Nyamuk & Lalat", "n": "Musca", "i": "img/p14_34.jpg", "t": ["Probosis untuk menghisap, bentuk seperti bel", "V4 melengkung menyudut"]}, {"g": "Nyamuk & Lalat", "n": "Hippobosca", "i": "img/p14_35.jpg", "t": ["Lalat penusuk", "Pembuluh darah sayap hilang / sayap tampak lebih kuat", "Kepala dan capit seperti kepiting"]}, {"g": "Nyamuk & Lalat", "n": "Stomoxys", "i": "img/stomoxys.jpg", "t": ["Lalat penghisap darah", "V4 melengkung tidak menyudut", "Palpus lebih pendek dari probosis", "Probosis seperti kuncup bunga"]}, {"g": "Tungau & Caplak", "n": "Sarcoptes", "i": "img/p16_36.jpg", "t": ["Anus di tepi (lateral/posterior)", "Pasangan kaki 3-4 tidak melewati tepi tubuh", "Bulat, garis tubuh melingkar"]}, {"g": "Tungau & Caplak", "n": "Notoedres", "i": "img/p16_37.jpg", "t": ["Anus dorsal", "Pasangan kaki 3-4 tidak melewati tepi tubuh", "Kaki pendek, tekstur tubuh kasar"]}, {"g": "Tungau & Caplak", "n": "Chorioptes", "i": "img/p16_38.jpg", "t": ["Pedikel tidak bersegmen", "Pasangan kaki 3-4 melewati tepi tubuh", "Kaki ke-4 paling pendek"]}, {"g": "Tungau & Caplak", "n": "Demodex", "i": "img/p17_39.jpg", "t": ["Bentuk seperti wortel / ulat", "Sangat kecil"]}, {"g": "Tungau & Caplak", "n": "Ornithonyssus", "i": "img/p17_40.jpg", "t": ["Tungau tidak kudis", "Maksila panjang seperti pedang", "Kaki tipis"]}, {"g": "Tungau & Caplak", "n": "Rhipicephalus", "i": "img/p18_41.jpg", "t": ["Palpus 3 segmen, segmen 1 dan 2 sama besar", "Ada peritreme", "Lengkung anal posterior"]}, {"g": "Tungau & Caplak", "n": "Ixodes", "i": "img/p18_42.jpg", "t": ["Lengkung anal di anterior anus", "Badan lebih lonjong", "Kaki lebih fleksibel"]}, {"g": "Tungau & Caplak", "n": "Amblyomma", "i": "img/p18_43.jpg", "t": ["Palpus segmen 2 lebih panjang dari segmen 1", "Badan bulat, kaki bersegmen"]}, {"g": "Tungau & Caplak", "n": "Haemaphysalis", "i": "img/p19_44.jpg", "t": ["Lengkung anal posterior", "Segmen ke-2 palpus melebar ke lateral", "Kepala segitiga, badan lebih bulat"]}, {"g": "Protozoa", "n": "Haemoproteus", "i": "img/p20_45.jpg", "t": ["Gamet seperti halter, mengelilingi inti", "Parasit melingkari inti (seperti gagang telepon)"]}, {"g": "Protozoa", "n": "Leucocytozoon", "i": "img/p20_46.jpg", "t": ["Gamet bulat pada limfosit dan eritrosit", "Gametosit oval di perifer, mendesak inti ke pinggir"]}, {"g": "Protozoa", "n": "Plasmodium", "i": "img/plasmodium.jpg", "t": ["Gerak meluncur", "Gamet bulat", "Skizon bulat tidak beraturan", "Merusak sel darah"]}, {"g": "Protozoa", "n": "Babesia", "i": "img/babesia.jpg", "t": ["Piriform berpasangan dengan ujung runcing", "Bentuk tidak beraturan di dalam eritrosit"]}, {"g": "Protozoa", "n": "Entamoeba", "i": "img/entamoeba.jpg", "t": ["Satu kista mengandung banyak inti"]}, {"g": "Protozoa", "n": "Balantidium", "i": "img/balantidium.jpg", "t": ["Intinya berbentuk ginjal"]}, {"g": "Protozoa", "n": "Eimeria", "i": "img/eimeria.jpg", "t": ["Ookista berbentuk elips atau lingkaran", "Tidak memiliki mikropil"]}, {"g": "Protozoa", "n": "Isospora", "i": "img/isospora.jpg", "t": ["Ookista belum bersporulasi: 1 sporoblas", "Setelah sporulasi: 2 sporokista"]}];
const MODES=[["fc","Flashcard"],["img2n","Gambar → Nama"],["n2img","Nama → Gambar"],["type","Ketik Nama"]];
let mode="fc",sel=new Set(),pool=[],idx=0,score=0,ans=0,wrong=new Set(),onlyWrong=false,flipped=false,done=false;
const $=s=>document.querySelector(s),G=[...new Set(DATA.map(d=>d.g))];
const shuffle=a=>{a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}return a};
const norm=s=>s.toLowerCase().replace(/[^a-z]/g,"");
function chips(){
 $("#modes").innerHTML=MODES.map(m=>`<button class="${m[0]==mode?'on':''}" data-m="${m[0]}">${m[1]}</button>`).join("");
 $("#groups").innerHTML=`<button class="chip ${sel.size==0?'on':''}" data-g="">Semua (${DATA.length})</button>`+G.map(g=>`<button class="chip ${sel.has(g)?'on':''}" data-g="${g}">${g} (${DATA.filter(d=>d.g==g).length})</button>`).join("");
 $("#rev").textContent=`Ulangi yang salah (${wrong.size})`;$("#rev").classList.toggle("on",onlyWrong)}
function start(){
 let base=DATA.filter(d=>(!sel.size||sel.has(d.g))&&(!onlyWrong||wrong.has(d.n)));
 pool=shuffle(base);idx=0;score=0;ans=0;done=false;flipped=false;chips();render()}
function prog(){$("#pb").style.width=(pool.length?idx/pool.length*100:0)+"%";
 $("#stat").textContent=pool.length?`Kartu ${Math.min(idx+1,pool.length)} / ${pool.length}`+(mode!="fc"?` · Skor ${score}/${ans}`:""):""}
function distract(c,k){const same=DATA.filter(d=>d.g==c.g&&d.n!=c.n),oth=DATA.filter(d=>d.g!=c.g);
 return shuffle([...shuffle(same).slice(0,k),...shuffle(oth)]).slice(0,k)}
function render(){
 const st=$("#stage");prog();
 if(!pool.length){st.innerHTML=`<div class="card">Tidak ada kartu. ${onlyWrong?"Belum ada yang salah 🎉":"Pilih kelompok lain."}</div>`;return}
 if(idx>=pool.length){st.innerHTML=`<div class="card" style="text-align:center"><h2>Selesai! 🎉</h2>${mode!="fc"?`<p>Skor: <b>${score} / ${ans}</b> (${Math.round(score/ans*100)}%)</p>`:""}<p class="hint">${wrong.size} kartu masih perlu diulang.</p><button class="p" onclick="start()">Main lagi</button></div>`;return}
 const c=pool[idx],traits=`<ul>${c.t.map(x=>`<li>${x}</li>`).join("")}</ul>`;
 if(mode=="fc"){
  st.innerHTML=`<div class="card fc" id="fc"><img class="img" src="${c.i}" alt="">${flipped?`<h2>${c.n}</h2><div class="hint">${c.g}</div>${traits}`:`<p class="hint">Tebak namanya, lalu klik kartu untuk membalik</p>`}</div>
  <div class="row" style="justify-content:center"><button id="prev">← Sebelumnya</button><button id="nok">❌ Belum hafal</button><button id="ok" class="p">✅ Hafal</button></div>`;
  $("#fc").onclick=()=>{flipped=!flipped;render()};
  $("#prev").onclick=()=>{if(idx>0){idx--;flipped=false;render()}};
  $("#ok").onclick=()=>{wrong.delete(c.n);next()};$("#nok").onclick=()=>{wrong.add(c.n);next()};
 }else if(mode=="img2n"){
  const o=shuffle([c,...distract(c,3)]);
  st.innerHTML=`<div class="card"><img class="img" src="${c.i}" alt=""><p><b>Ini parasit apa?</b></p><div class="opts">${o.map(x=>`<button data-n="${x.n}">${x.n}</button>`).join("")}</div><div id="fb"></div></div>`;
  st.querySelectorAll(".opts button").forEach(b=>b.onclick=()=>pick(b,c,true));
 }else if(mode=="n2img"){
  const o=shuffle([c,...distract(c,3)]);
  st.innerHTML=`<div class="card"><p><b>Mana gambar <span style="color:var(--ac)">${c.n}</span>?</b></p><div class="opts">${o.map(x=>`<button data-n="${x.n}"><img src="${x.i}" alt=""></button>`).join("")}</div><div id="fb"></div></div>`;
  st.querySelectorAll(".opts button").forEach(b=>b.onclick=()=>pick(b,c,true));
 }else{
  st.innerHTML=`<div class="card"><img class="img" src="${c.i}" alt=""><p><b>Ketik nama parasit ini:</b></p><input type="text" id="in" autocomplete="off" autofocus placeholder="contoh: Moniezia"><div class="row"><button class="p" id="chk">Cek jawaban</button><button id="skip">Tidak tahu</button></div><div id="fb"></div></div>`;
  const chk=g=>{if(done)return;done=true;const ok=!g&&norm($("#in").value)==norm(c.n);ans++;if(ok){score++;wrong.delete(c.n)}else wrong.add(c.n);
   $("#fb").innerHTML=`<div class="fb">${ok?"✅ Benar!":"❌ Jawabannya:"} <b>${c.n}</b><ul>${c.t.map(x=>`<li>${x}</li>`).join("")}</ul><button class="p" id="nx">Lanjut →</button></div>`;$("#nx").onclick=next;$("#nx").focus()};
  $("#chk").onclick=()=>chk(false);$("#skip").onclick=()=>chk(true);$("#in").onkeydown=e=>{if(e.key=="Enter")done?next():chk(false)}}
}
function pick(b,c){if(done)return;done=true;ans++;const ok=b.dataset.n==c.n;
 document.querySelectorAll(".opts button").forEach(x=>{if(x.dataset.n==c.n)x.classList.add("ok");x.disabled=true});
 if(ok){score++;wrong.delete(c.n)}else{b.classList.add("bad");wrong.add(c.n)}
 $("#fb").innerHTML=`<div class="fb">${ok?"✅ Benar!":"❌ Salah."} <b>${c.n}</b><ul>${c.t.map(x=>`<li>${x}</li>`).join("")}</ul><button class="p" id="nx">Lanjut →</button></div>`;$("#nx").onclick=next;prog()}
function next(){idx++;done=false;flipped=false;render()}
document.addEventListener("click",e=>{const m=e.target.dataset.m,g=e.target.dataset.g;
 if(m){mode=m;start()}else if(g!==undefined){if(g==="")sel.clear();else sel.has(g)?sel.delete(g):sel.add(g);start()}});
$("#shuf").onclick=start;$("#rev").onclick=()=>{onlyWrong=!onlyWrong;start()};
document.addEventListener("keydown",e=>{if(mode=="fc"&&e.target.tagName!="INPUT"){if(e.key==" "){e.preventDefault();flipped=!flipped;render()}if(e.key=="ArrowRight")next()}});
start();
</script></body></html>
